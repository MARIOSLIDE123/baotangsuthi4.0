  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Hồ sơ cá nhân học sinh, giáo viên và quản trị viên."
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/Classroom" },
      "description": "Danh sách lớp học và mã tham gia của giáo viên."
    },
    "/learningProgress/{progressId}": {
      "schema": { "$ref": "#/entities/LearningProgress" },
      "description": "Tiến độ học tập theo 3 trạng thái cho từng phân hệ."
    },
    "/quizAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/QuizAttempt" },
      "description": "Kết quả trò chơi, đọc hiểu, La bàn và 3D của học sinh."
    },
    "/badges/{badgeId}": {
      "schema": { "$ref": "#/entities/BadgeRecord" },
      "description": "Huy hiệu lớp học và lịch sử đạt huy hiệu."
    },
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Nhiệm vụ học tập theo lớp."
    },
    "/assignments/{assignmentId}/submissions/{studentUid}": {
      "schema": { "$ref": "#/entities/AssignmentSubmission" },
      "description": "Bài nộp và điểm đánh giá nhiệm vụ của học sinh."
    },
    "/teacherSettings/{settingId}": {
      "schema": { "$ref": "#/entities/TeacherSetting" },
      "description": "Cấu hình Padlet và chế độ hội giảng của giáo viên."
    }
  }
}
