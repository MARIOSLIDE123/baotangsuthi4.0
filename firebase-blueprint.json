          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "academicYear": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "joinCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teacherUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teacherName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
