        "classId",
        "name",
        "school",
        "academicYear",
        "joinCode",
        "teacherUid",
        "teacherName",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "LearningProgress": {
      "title": "LearningProgress",
      "description": "Tiến độ từng phân hệ theo 3 trạng thái dựa trên hành động và kết quả thực tế.",
      "type": "object",
      "properties": {
        "progressId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
