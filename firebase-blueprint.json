{
  "entities": {
    "User": {
      "title": "User",
      "description": "Hồ sơ người dùng (học sinh, giáo viên, quản trị viên). Không thu thập số điện thoại hay thông tin nhạy cảm thừa.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "school": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "className": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "classId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "joinCode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "teacherUid": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "avatarPreset": {
          "type": "string",
          "enum": ["dam-san", "hnhi", "gong", "sun", "google"]
        },
        "avatarUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["student", "teacher", "admin"]
        },
        "totalScore": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "school",
        "className",
        "classId",
        "joinCode",
        "teacherUid",
        "avatarPreset",
        "avatarUrl",
        "role",
        "totalScore",
        "createdAt",
        "updatedAt"
      ]
    },
