          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "moduleId": {
          "type": "string",
          "enum": [
            "epic-gate",
            "vietnam-epics",
            "world-epics",
            "museum-3d",
            "dam-san-journey",
            "hero-arena",
            "stem-studio"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "completed"]
        },
        "actionsCompleted": {
          "type": "array"
        },
        "exploredWorks": {
          "type": "array"
        },
        "requiredActionsCount": {
          "type": "number"
        },
        "scoreEarned": {
          "type": "number"
        },
        "lastActivityLabel": {
          "type": "string",
          "minLength": 0,
          "maxLength": 140
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "progressId",
        "studentUid",
        "classId",
        "teacherUid",
        "moduleId",
        "status",
        "actionsCompleted",
        "exploredWorks",
        "requiredActionsCount",
        "scoreEarned",
        "lastActivityLabel",
        "createdAt",
        "updatedAt"
      ]
